<!DOCTYPE html>
<html>

<head>

<title>{{subject}} Quiz</title>

<style>

body {
    font-family:Arial;
    background:#f5f7fb;
    padding:30px;
}

.container {
    max-width:800px;
    margin:auto;
}

.question {
    background:white;
    padding:25px;
    margin-bottom:20px;
    border-radius:15px;
    box-shadow:0 3px 15px rgba(0,0,0,.1);
}

.option {
    display:block;
    margin:12px 0;
}

button {
    padding:15px 30px;
    background:#4f46e5;
    color:white;
    border:none;
    border-radius:8px;
    cursor:pointer;
}

</style>

</head>

<body>

<div class="container">

<h1>🧠 {{subject}} Quiz</h1>

<p>
Answer all questions carefully.
</p>

<form
    method="POST"
    action="/result/{{subject}}"
>

{% for q in questions %}

<div class="question">

    <h3>
        Q{{loop.index}}.
        {{q.question}}
    </h3>

    {% for option in q.options %}

    <label class="option">

        <input
            type="radio"
            name="q{{loop.parent.index0}}"
            value="{{option}}"
            required
        >

        {{option}}

    </label>

    {% endfor %}

</div>

{% endfor %}

<button type="submit">
    Submit Quiz
</button>

</form>

</div>

</body>

</html>
